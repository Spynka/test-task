    <script>
  // Удаляет #hash из URL (без перезагрузки)
  function clearHash() {
    if (location.hash) {
      history.replaceState(null, "", location.pathname + location.search);
    }
  }

  // Плавный скролл к элементу по #id
  function smoothScrollToHash(hash) {
    const id = hash.slice(1);
    const target = document.getElementById(id);

    if (!target) return false;

    // Плавно скроллим
    target.scrollIntoView({ behavior: "smooth", block: "start" });

    // После старта скролла стираем хеш (без скачка)
    // Можно сразу, но небольшой таймаут делает поведение стабильнее в разных браузерах
    setTimeout(clearHash, 50);

    return true;
  }

  // Перехват клика по якорным ссылкам
  document.addEventListener("click", (e) => {
    const a = e.target.closest('a[href^="#"]');
    if (!a) return;

    const hash = a.getAttribute("href");
    if (!hash || hash === "#") return;

    // Если ссылка на несуществующий id — пусть браузер делает как умеет
    const ok = smoothScrollToHash(hash);
    if (ok) {
      e.preventDefault(); // важно: иначе браузер сам прыгнет и поставит hash
    }
  });

  // Если хеш появился не от клика (вставили URL с #, обновили страницу)
  window.addEventListener("load", () => {
    if (location.hash) {
      const hash = location.hash;
      // чтобы не было резкого прыжка при загрузке
      setTimeout(() => {
        smoothScrollToHash(hash);
      }, 0);
    }
  });
</script>
